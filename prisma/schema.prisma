// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteSettings {
  id              String   @id @default("global")
  siteTitle       String?
  siteDescription String?
  ogImageUrl      String?
  ogImageKey      String?
  faviconUrl      String?
  faviconKey      String?
  logoUrl         String?
  logoKey         String?
  updatedAt       DateTime @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BLOCKED
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CHARGILY
  CASH_ON_DELIVERY
}

enum CertificateType {
  FREE
  NATIONAL
  INTERNATIONAL
}

enum CertificateRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum AuditActorRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum ContentType {
  VIDEO
  QUIZ
  EXTERNAL
  PDF
  SURVEY
  TITLE
  CERTIFICATE
  EXERCISE
  AUDIO
  CHECKLIST
  DOCUMENT
  IMAGE
}

model User {
  id              String        @id @default(cuid())
  role            UserRole
  status          AccountStatus @default(ACTIVE)
  email           String?       @unique
  phone           String?       @unique
  passwordHash    String
  fullName        String?
  /// Public teacher bio shown on course landing and teacher dashboard.
  bio             String?
  /// Public teacher profile picture shown on course landing and cards.
  avatarUrl       String?
  avatarKey       String?
  whatsapp        String?
  notificationPrefs Json?
  termsAcceptedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  courses         Course[]
  orders          Order[]
  reviews         Review[]
  auditLogs       AuditLog[]
  courseItemProgress CourseItemProgress[]
  courseNotes     CourseNote[]
  questions       CourseQuestion[]
  questionReplies CourseQuestionReply[]
  certificateRequests CertificateRequest[]
  itemSubmissions CourseItemSubmission[]
}

model CourseCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  imageKey    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@index([isActive])
  @@index([sortOrder])
}

model Course {
  id               String       @id @default(cuid())
  teacherId        String
  status           CourseStatus @default(DRAFT)
  title            String
  /// Legacy display name; kept for backward compatibility with existing pages.
  category         String
  categoryId       String?
  price            Int
  /// Optional original ("was") price used to show a real discount on the sales page.
  originalPrice    Int?
  imageUrl         String?
  /// Main course video URL (Vimeo)
  videoUrl         String?
  duration         String?
  level            String?
  language         String?
  description      String?
  learningOutcomes Json
  salesPageData    Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  teacher          User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseCategory   CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sections         CourseSection[]
  orders           Order[]
  reviews         Review[]
  itemProgress     CourseItemProgress[]
  notes            CourseNote[]
  questions        CourseQuestion[]
  certificateRequests CertificateRequest[]
  itemSubmissions  CourseItemSubmission[]

  @@index([teacherId])
  @@index([status])
  @@index([categoryId])
}

model CourseQuestion {
  id         String   @id @default(cuid())
  courseId   String
  userId     String
  content    String
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  course   Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies  CourseQuestionReply[]

  @@index([courseId, createdAt])
  @@index([userId])
}

model CourseQuestionReply {
  id          String   @id @default(cuid())
  questionId  String
  userId      String
  content     String
  isHidden    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
  @@index([userId])
}

model CourseNote {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  itemId     String?
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, itemId])
  @@index([userId, courseId])
}

model Order {
  id                 String         @id @default(cuid())
  userId             String?
  courseId           String
  status             OrderStatus    @default(PENDING)
  amount             Int
  paymentMethod      PaymentMethod?
  deliveryFee        Int            @default(0)
  guestFullName      String?
  guestPhone         String?
  checkoutToken      String?        @unique
  adminNotes         String?
  chargilyCheckoutId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course             Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([guestPhone])
}

model CertificateRequest {
  id              String                   @id @default(cuid())
  userId          String
  courseId        String
  certificateType CertificateType
  fullName        String
  placeOfBirth    String
  dateOfBirth     DateTime
  note            String?
  status          CertificateRequestStatus @default(PENDING)
  adminNotes      String?
  certificateFileUrl      String?
  certificateFileKey      String?
  certificateFileName     String?
  certificateFileMime     String?
  certificateUploadedAt   DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([certificateType])
}

model CourseSection {
  id        String             @id @default(cuid())
  courseId  String
  title     String
  position  Int
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  items     CourseSectionItem[]

  @@index([courseId])
}

model CourseSectionItem {
  id        String        @id @default(cuid())
  sectionId String
  type      ContentType
  title     String
  duration  String?
  url       String?
  position  Int
  extraData Json?
  section     CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress    CourseItemProgress[]
  submissions CourseItemSubmission[]

  @@index([sectionId])
}

model CourseItemSubmission {
  id          String      @id @default(cuid())
  userId      String
  courseId    String
  itemId      String
  type        ContentType
  answers     Json
  score       Int?
  submittedAt DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  item   CourseSectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, courseId])
  @@index([itemId])
}

model CourseItemProgress {
  id             String           @id @default(cuid())
  userId         String
  courseId       String
  itemId         String
  startedAt      DateTime?
  lastViewedAt   DateTime?
  completedAt    DateTime?
  progressPercent Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  item   CourseSectionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, courseId])
  @@index([userId, lastViewedAt])
}

model Review {
  id                   String    @id @default(cuid())
  courseId             String
  userId               String
  rating               Int
  comment              String?
  createdAt            DateTime  @default(now())
  deletionRequestedAt  DateTime?
  deletionRequestedBy  String?
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@index([userId])
}

model AuditLog {
  id         String         @id @default(cuid())
  actorId    String
  actorRole  AuditActorRole
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime       @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
